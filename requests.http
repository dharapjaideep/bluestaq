# Example requests for the Notes Service (IntelliJ HTTP Client format).
#
# Start the app first (./mvnw spring-boot:run). The demo data seeder creates:
#   alice@demo.com, bob@demo.com, carol@demo.com  (password: password123)
#   team "Engineering" with alice and bob as members (carol is not in it)
# Run the requests top to bottom: later ones reuse ids (and note versions) captured by earlier ones.
# PUT /notes/{id} must send the note's current "version" (optimistic locking); a stale one -> 409.
# The database persists in data/; stop the app and delete data/ to reset to the demo state.

@host = http://localhost:8080
@password = password123

### ----- Auth -----

### Register a new account -> 201 (409 if you run it twice: the email is taken)
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "dave@demo.com",
  "password": "password123"
}

### Who am I? -> 200 with alice's id and email
GET {{host}}/auth/me
Authorization: Basic alice@demo.com {{password}}

### Wrong password -> 401
GET {{host}}/auth/me
Authorization: Basic alice@demo.com wrong-password

### ----- Listing and search -----

### Alice lists her notes -> her personal note + both Engineering notes
GET {{host}}/notes
Authorization: Basic alice@demo.com {{password}}

> {%
    // Remember the Engineering team id for the requests below.
    client.global.set("teamId", response.body.find(note => note.teamId !== null).teamId);
%}

### Bob lists his notes -> his personal note + the Engineering notes (not alice's personal note)
GET {{host}}/notes
Authorization: Basic bob@demo.com {{password}}

### Carol lists her notes -> only her own; she is not in Engineering
GET {{host}}/notes
Authorization: Basic carol@demo.com {{password}}

### Filter by team -> only Engineering notes
GET {{host}}/notes?teamId={{teamId}}
Authorization: Basic alice@demo.com {{password}}

### Case-insensitive search in title and content -> "Sprint 12 plan"
GET {{host}}/notes?q=SPRINT
Authorization: Basic bob@demo.com {{password}}

### ----- Create -----

### Alice creates a note shared with Engineering -> 201
POST {{host}}/notes
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "title": "Release checklist",
  "content": "Tag the build; update the changelog.",
  "teamId": {{teamId}}
}

> {%
    client.global.set("sharedNoteId", response.body.id);
    client.global.set("sharedVersion", response.body.version);
%}

### Alice creates a personal note -> 201 (no teamId = personal)
POST {{host}}/notes
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "title": "Alice's private draft",
  "content": "Only alice can see this."
}

> {%
    client.global.set("privateNoteId", response.body.id);
    client.global.set("privateVersion", response.body.version);
%}

### Carol tries to create a note in Engineering -> 400 (fieldErrors.teamId): she is not a member
POST {{host}}/notes
Authorization: Basic carol@demo.com {{password}}
Content-Type: application/json

{
  "title": "Sneaky",
  "teamId": {{teamId}}
}

### Blank title -> 400 (fieldErrors.title)
POST {{host}}/notes
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "title": " "
}

### ----- Sharing rules: team member (bob) -----

### Bob reads alice's shared note -> 200
GET {{host}}/notes/{{sharedNoteId}}
Authorization: Basic bob@demo.com {{password}}

### Bob edits the shared note -> 200 (PUT replaces the note, so he sends the teamId back,
### plus the version he read); the response carries the new version
PUT {{host}}/notes/{{sharedNoteId}}
Authorization: Basic bob@demo.com {{password}}
Content-Type: application/json

{
  "title": "Release checklist",
  "content": "Tag the build; update the changelog; notify QA. (edited by bob)",
  "teamId": {{teamId}},
  "version": {{sharedVersion}}
}

> {% if (response.status === 200) client.global.set("sharedVersion", response.body.version); %}

### Alice saves an edit based on the version she read before bob's change -> 409 Conflict
### ("This note was changed by someone else...") and the note is unchanged
PUT {{host}}/notes/{{sharedNoteId}}
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "title": "Release checklist",
  "content": "Alice's edit made on a stale copy",
  "teamId": {{teamId}},
  "version": 0
}

### PUT without a version -> 400 (fieldErrors.version)
PUT {{host}}/notes/{{sharedNoteId}}
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "title": "Release checklist",
  "teamId": {{teamId}}
}

### Bob tries to move it out of the team (no teamId = personal) -> 403: only the owner can move it
PUT {{host}}/notes/{{sharedNoteId}}
Authorization: Basic bob@demo.com {{password}}
Content-Type: application/json

{
  "title": "Release checklist",
  "content": "Mine now",
  "version": {{sharedVersion}}
}

### Bob tries to delete the shared note -> 403: only the owner can delete
DELETE {{host}}/notes/{{sharedNoteId}}
Authorization: Basic bob@demo.com {{password}}

### Bob tries to read alice's personal note -> 404 (not 403, so its existence isn't revealed)
GET {{host}}/notes/{{privateNoteId}}
Authorization: Basic bob@demo.com {{password}}

### ----- Sharing rules: non-member (carol) -----

### Carol tries to read the Engineering note -> 404
GET {{host}}/notes/{{sharedNoteId}}
Authorization: Basic carol@demo.com {{password}}

### ----- Owner actions (alice) -----

### Alice moves her personal note into Engineering -> 200; bob can now see it
PUT {{host}}/notes/{{privateNoteId}}
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "title": "Alice's draft (now shared)",
  "content": "Shared with Engineering.",
  "teamId": {{teamId}},
  "version": {{privateVersion}}
}

### Bob reads the newly shared note -> 200
GET {{host}}/notes/{{privateNoteId}}
Authorization: Basic bob@demo.com {{password}}

### Alice deletes the shared note -> 204 (teams are demonstrated below)
DELETE {{host}}/notes/{{sharedNoteId}}
Authorization: Basic alice@demo.com {{password}}

### The deleted note is gone -> 404
GET {{host}}/notes/{{sharedNoteId}}
Authorization: Basic alice@demo.com {{password}}

### ----- Teams -----

### Alice lists her teams -> Engineering, with members alice and bob
GET {{host}}/teams
Authorization: Basic alice@demo.com {{password}}

### Alice creates a team -> 201; she is its creator and first member
POST {{host}}/teams
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "name": "Design"
}

> {% client.global.set("designTeamId", response.body.id); %}

### Alice adds carol by email -> 201 with the updated member list
POST {{host}}/teams/{{designTeamId}}/members
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "email": "carol@demo.com"
}

> {%
    client.global.set("aliceId", response.body.members.find(m => m.email === "alice@demo.com").id);
    client.global.set("carolId", response.body.members.find(m => m.email === "carol@demo.com").id);
%}

### Adding carol again -> 409: already a member
POST {{host}}/teams/{{designTeamId}}/members
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "email": "carol@demo.com"
}

### Adding an unknown email -> 404
POST {{host}}/teams/{{designTeamId}}/members
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "email": "nobody@demo.com"
}

### Bob (not in Design) tries to add himself -> 404: non-members can't see the team
POST {{host}}/teams/{{designTeamId}}/members
Authorization: Basic bob@demo.com {{password}}
Content-Type: application/json

{
  "email": "bob@demo.com"
}

### Carol (now a member) adds bob -> 201: any member can add
POST {{host}}/teams/{{designTeamId}}/members
Authorization: Basic carol@demo.com {{password}}
Content-Type: application/json

{
  "email": "bob@demo.com"
}

> {% client.global.set("bobId", response.body.members.find(m => m.email === "bob@demo.com").id); %}

### Carol now sees Design in her teams
GET {{host}}/teams
Authorization: Basic carol@demo.com {{password}}

### Alice shares a note with Design -> 201
POST {{host}}/notes
Authorization: Basic alice@demo.com {{password}}
Content-Type: application/json

{
  "title": "Design review",
  "content": "New logo options.",
  "teamId": {{designTeamId}}
}

> {% client.global.set("designNoteId", response.body.id); %}

### Carol reads the Design note -> 200
GET {{host}}/notes/{{designNoteId}}
Authorization: Basic carol@demo.com {{password}}

### Bob tries to remove carol -> 403: only the creator can remove others
DELETE {{host}}/teams/{{designTeamId}}/members/{{carolId}}
Authorization: Basic bob@demo.com {{password}}

### Alice (the creator) removes carol -> 204
DELETE {{host}}/teams/{{designTeamId}}/members/{{carolId}}
Authorization: Basic alice@demo.com {{password}}

### Carol has lost access to the Design note immediately -> 404
GET {{host}}/notes/{{designNoteId}}
Authorization: Basic carol@demo.com {{password}}

### Bob removes himself -> 204: members can always leave
DELETE {{host}}/teams/{{designTeamId}}/members/{{bobId}}
Authorization: Basic bob@demo.com {{password}}

### Alice tries to remove herself -> 409: the creator can't be removed
DELETE {{host}}/teams/{{designTeamId}}/members/{{aliceId}}
Authorization: Basic alice@demo.com {{password}}

### ----- Unauthenticated -----

### No credentials -> 401
GET {{host}}/notes
